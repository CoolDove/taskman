<?xml version="1.0" encoding="utf-8"?>
<!-- package 由构建脚本注入（Gradle 用 namespace），这里保持干净 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="20"
    android:versionName="2.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- 列出全部已安装应用（否则包可见性会过滤掉大部分图标/名称） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 结束后台进程 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 读取使用情况（需用户在系统设置里手动授予） -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Shizuku：借 shell 权限读系统任务栈 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="app.dsh.running.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
